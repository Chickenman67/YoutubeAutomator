# Environment variables for YouTube Automation System
# Copy this file to .env and fill in your actual API keys

# Groq API key for LLM (script generation, explainability checks)
GROQ_API_KEY=

# YouTube Data API v3 credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# NewsAPI free tier (optional trending source; leave blank to skip)
NEWSAPI_API_KEY=
